@model List<string>
@{
    ViewData["Title"] = "Event Logs";
}

<div class="container mt-4">
    <h1 class="mb-4">Event Logs</h1>
    
    <p class="text-muted">
        These logs are generated by the <code>LoggingService</code> which subscribes to 
        <code>OrderPlaced</code> and <code>StockChanged</code> events.
    </p>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var log in Model)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-journal-text"></i> @log
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No logs yet. Place an order to see events in action!
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-primary">Back to Products</a>
        <a asp-action="Emails" class="btn btn-secondary">View Emails</a>
    </div>
</div>
