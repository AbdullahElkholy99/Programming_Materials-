@model List<string>
@{
    ViewData["Title"] = "Sent Emails";
}

<div class="container mt-4">
    <h1 class="mb-4">Sent Emails</h1>
    
    <p class="text-muted">
        These emails are generated by the <code>EmailService</code> which subscribes to 
        the <code>NotificationRequired</code> event.
    </p>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var email in Model)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-envelope"></i> @email
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No emails sent yet. Place an order to see email notifications!
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-primary">Back to Products</a>
        <a asp-action="Logs" class="btn btn-secondary">View Logs</a>
    </div>
</div>
